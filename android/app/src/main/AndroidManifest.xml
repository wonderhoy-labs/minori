<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<!-- Run VMs at all, and boot a Linux kernel that isn't Microdroid. Granted with adb or Shizuku. -->
	<uses-permission
		android:name="android.permission.MANAGE_VIRTUAL_MACHINE"
		tools:ignore="ProtectedPermissions" />
	<uses-permission
		android:name="android.permission.USE_CUSTOM_VIRTUAL_MACHINE"
		tools:ignore="ProtectedPermissions" />
	<!-- Downloading catalog images, and published ports that other devices may reach. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Android 17 lets other devices on the network reach an app only with this, for ports published to the network. -->
	<uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
	<!-- Keeps the process, and so its VMs, alive while machines run. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<!-- The Termux backend runs proot-distro through Termux's documented RUN_COMMAND intent. -->
	<uses-permission android:name="com.termux.permission.RUN_COMMAND" />
	<uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

	<uses-feature
		android:name="android.software.virtualization_framework"
		android:required="false" />

	<queries>
		<package android:name="moe.shizuku.privileged.api" />
		<package android:name="com.termux" />
		<!-- Airi, whose agent Minori installs in a machine so Airi can show that machine's apps. -->
		<package android:name="com.wonderhoylabs.airi" />
		<!-- Android's Linux terminal, whose traffic Minori can carry (net/TerminalLink.kt). -->
		<package android:name="com.android.virtualization.terminal" />
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="rdp" />
		</intent>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="ssh" />
		</intent>
	</queries>

	<application
		android:name=".MinoriApp"
		android:allowBackup="false"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:theme="@style/Theme.Minori">

		<activity
			android:name=".ui.MainActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
			android:exported="true"
			android:launchMode="singleTask"
			android:resizeableActivity="true"
			android:windowSoftInputMode="adjustResize">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
			<!-- Airi hands over its token, to set Airi up in a machine: see docs/airi.md. -->
			<intent-filter>
				<action android:name="com.wonderhoylabs.minori.action.SET_UP_AIRI" />
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>
			<!-- minori://vm/<id>[/console|ssh|vnc] opens a machine's page or one of its screens. It never starts anything. -->
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<data
					android:host="vm"
					android:scheme="minori" />
			</intent-filter>
		</activity>

		<!--
			Airi starts a stopped machine through this when one of its apps is opened. It shows nothing, and only starts
			machines that Airi is set up in, which minori://vm/<id>/app/<desktop id> already lets any app do.
		-->
		<activity
			android:name=".ui.AiriStartActivity"
			android:excludeFromRecents="true"
			android:exported="true"
			android:noHistory="true"
			android:theme="@android:style/Theme.Translucent.NoTitleBar">
			<intent-filter>
				<action android:name="com.wonderhoylabs.minori.action.START_FOR_AIRI" />
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</activity>

		<!--
			Airi lists the machines it can use and reaches its agent in them through this, instead of a port on the phone,
			so Android's terminal and Minori's machines work together. It checks that the caller is Airi or adb's shell.
		-->
		<provider
			android:name=".service.AiriProvider"
			android:authorities="com.wonderhoylabs.minori.airi"
			android:exported="true"
			tools:ignore="ExportedContentProvider" />

		<!-- adb's shell may start it, to wake Minori for a page; DUMP is held by the shell, not by apps. -->
		<service
			android:name=".service.MinoriService"
			android:exported="true"
			android:foregroundServiceType="specialUse"
			android:permission="android.permission.DUMP"
			tools:ignore="ExportedService">
			<property
				android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
				android:value="Runs the virtual machines the user started, which live in this app's process, and answers a computer that's using them over adb." />
		</service>

		<!-- Termux's answers to RUN_COMMAND come back through a PendingIntent Minori made, so this needn't be exported. -->
		<receiver
			android:name=".backend.TermuxResultReceiver"
			android:exported="false" />

		<receiver
			android:name=".service.BootReceiver"
			android:exported="false">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
			</intent-filter>
		</receiver>

		<provider
			android:name="rikka.shizuku.ShizukuProvider"
			android:authorities="${applicationId}.shizuku"
			android:enabled="true"
			android:exported="true"
			android:multiprocess="false"
			android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
	</application>
</manifest>
